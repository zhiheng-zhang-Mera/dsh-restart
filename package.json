{
  "name": "dsh-restart",
  "version": "0.1.0",
  "description": "Safe restart execution for DeepSeek Harness: request validation, checkpoint gating, restart locking, graceful shutdown, crash-loop breaking and an external supervisor. It never decides when to restart.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "reboot",
    "supervisor",
    "checkpoint",
    "crash-loop"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/plugin/index.js",
  "types": "lib/plugin/index.d.ts",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "dsh-restart-supervisor": "bin/supervisor.mjs"
  },
  "files": [
    "lib",
    "src",
    "shared",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    },
    "./protocol": {
      "types": "./lib/shared/protocol.d.ts",
      "default": "./lib/shared/protocol.js"
    },
    "./supervisor": {
      "types": "./lib/supervisor/index.d.ts",
      "default": "./lib/supervisor/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "test:only": "node --test tests/*.test.js",
    "supervisor": "node bin/supervisor.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:patch": "node scripts/verify-patch.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
