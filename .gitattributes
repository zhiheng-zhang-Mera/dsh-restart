# Normalize line endings in the repository so a Windows checkout and a Linux
# checkout produce the same bytes for the files that matter.
* text=auto eol=lf

# Windows-only deployment scripts must keep CRLF so PowerShell parses them
# correctly on every host that runs them.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary

# Generated, but diffable enough to keep in review
package-lock.json text eol=lf -diff linguist-generated
